{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Jekyll Forge",
  "colors": {
    "primary": "#981518",
    "light": "#981518",
    "dark": "#F18B8D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Use Forge",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "quickstart",
              "reference/current-state"
            ]
          },
          {
            "group": "Write and publish",
            "pages": [
              "guides/github-access",
              "guides/workspaces",
              "guides/editor",
              "guides/drafts-and-recovery",
              "guides/publishing",
              "guides/scheduling",
              "guides/assets"
            ]
          },
          {
            "group": "Make it yours",
            "pages": [
              "guides/ai",
              "guides/deadpool-cool",
              "guides/themes-and-health",
              "guides/display-mode",
              "guides/social-and-mobile"
            ]
          },
          {
            "group": "Fix the problem",
            "pages": [
              "troubleshooting/common-problems",
              "reference/glossary"
            ]
          }
        ]
      },
      {
        "tab": "Run and develop",
        "groups": [
          {
            "group": "Operate Forge",
            "pages": [
              "hosting/architecture",
              "hosting/local-development",
              "hosting/deploy",
              "hosting/security-and-backups",
              "reference/configuration"
            ]
          },
          {
            "group": "Implementation reference",
            "pages": [
              "reference/ai-catalog",
              "reference/data-model",
              "reference/api-overview"
            ]
          },
          {
            "group": "Procedure catalog",
            "pages": [
              "reference/api/auth",
              "reference/api/system",
              "reference/api/ab-testing",
              "reference/api/ai",
              "reference/api/ai-providers",
              "reference/api/assets",
              "reference/api/blocks",
              "reference/api/github",
              "reference/api/notifications",
              "reference/api/posts",
              "reference/api/repurposing",
              "reference/api/scheduler",
              "reference/api/sites",
              "reference/api/snapshots",
              "reference/api/social-media"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Source code",
        "href": "https://github.com/CassieMarie0728/jekyll-forge"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch Forge",
      "href": "https://jekyll-forge.c728.workers.dev/repos"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode",
      "aistudio",
      "devin",
      "grok",
      "add-mcp",
      "devin-mcp"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/CassieMarie0728/jekyll-forge"
    }
  },
  "background": {
    "color": {
      "light": "#f5f5f5",
      "dark": "#0b0f0f"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk"
    },
    "body": {
      "family": "Source Sans Pro"
    }
  },
  "description": "The Jekyll Forge field manual: writing, recovery, GitHub publishing, optional AI, and self-hosting."
}
